{:paths ["src" "test"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        org.clojure/clojurescript {:mvn/version "1.10.914"}}
 :aliases
 {;; :main-opts added 2026-07-25: with only :extra-paths, `kbb -M:test`
  ;; ran nothing and there was no runner script either, so this suite was
  ;; unreachable. run-tests.kotoba runs the same suite under nbb.
  :test {:main-opts ["-m" "gamblingfacilityops.test"]
         :extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}}
  :nbb {:extra-deps {com.github.nbb/nbb {:mvn/version "1.2.196"}}}
  ;; kbb -M:render-html [out-file]
  ;;   -> regenerate docs/samples/operator-console.html by RUNNING the real
  ;;      actor (operation -> governor -> store -> phase). Flagship checklist
  ;;      item 2. The renderer is the only thing that needs the design system,
  ;;      so it is scoped to this alias rather than added to :deps -- the
  ;;      actor itself stays dependency-light and portable.
  ;;      jp-go-digital-design-system is consumed as a git coordinate, not a
  ;;      :local/root, so a standalone fork of this repo outside the monorepo
  ;;      can still resolve it.
  :render-html {:main-opts ["-m" "gamblingfacilityops.render-html"]
                :extra-deps {io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "e09192276fd6a111dfb9959bfc75ddeba555e840"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}}
  ;; No :lint alias existed at all, so nothing ever linted this repo.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
